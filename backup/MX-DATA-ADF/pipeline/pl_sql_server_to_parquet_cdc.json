{
	"name": "pl_sql_server_to_parquet_cdc",
	"properties": {
		"activities": [
			{
				"name": "sql_server_to_parquet_cdc",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "Count total rows",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "If version change",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "1.00:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "df_sql_server_cdc",
						"type": "DataFlowReference",
						"parameters": {
							"container": {
								"value": "'@{pipeline().globalParameters.storage_container_datalake}'",
								"type": "Expression"
							},
							"datastore_name": {
								"value": "'@{pipeline().parameters.datastore_name}'",
								"type": "Expression"
							},
							"schema_name": {
								"value": "'@{pipeline().parameters.schema_name}'",
								"type": "Expression"
							},
							"table_name": {
								"value": "'@{pipeline().parameters.table_name}'",
								"type": "Expression"
							},
							"pk": {
								"value": "'@{pipeline().parameters.pk}'",
								"type": "Expression"
							}
						},
						"datasetParameters": {
							"source": {
								"schema_name": {
									"value": "@pipeline().parameters.schema_name",
									"type": "Expression"
								},
								"table_name": {
									"value": "@pipeline().parameters.table_name",
									"type": "Expression"
								},
								"server_name": {
									"value": "@pipeline().parameters.server_name",
									"type": "Expression"
								},
								"database_name": {
									"value": "@pipeline().parameters.database_name",
									"type": "Expression"
								},
								"user_name": {
									"value": "@pipeline().parameters.user_name",
									"type": "Expression"
								},
								"secret_name": {
									"value": "@pipeline().parameters.secret_name",
									"type": "Expression"
								},
								"key_vault_uri": {
									"value": "@pipeline().globalParameters.key_vault_uri",
									"type": "Expression"
								}
							}
						},
						"linkedServiceParameters": {
							"sink": {
								"linkedService": {
									"storage_account_uri": {
										"value": "@pipeline().globalParameters.storage_account_datalake_uri",
										"type": "Expression"
									}
								}
							}
						}
					},
					"integrationRuntime": {
						"referenceName": "cdc-runtime",
						"type": "IntegrationRuntimeReference"
					},
					"traceLevel": "Coarse",
					"continuationSettings": {
						"customizedCheckpointKey": {
							"value": "@concat(pipeline().parameters.database_name, pipeline().parameters.schema_name, pipeline().parameters.table_name, pipeline().parameters.checkpoint_version)",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute adb ingestion",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "sql_server_to_parquet_cdc",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trigger_adb_ingestion",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@concat(pipeline().parameters.schema_name, '_', pipeline().parameters.table_name)",
							"type": "Expression"
						},
						"datastore_name": {
							"value": "@toLower(pipeline().parameters.datastore_name)\n",
							"type": "Expression"
						},
						"total_rows": {
							"value": "@activity('Count total rows').output.value[0]['total_rows']",
							"type": "Expression"
						},
						"skip_orchestration": {
							"value": "@pipeline().parameters.skip_orchestration",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Count total rows",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT COUNT(*) as total_rows FROM ', pipeline().parameters.schema_name, '.', pipeline().parameters.table_name, ' WITH (NOLOCK)')\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_server_cdc",
						"type": "DatasetReference",
						"parameters": {
							"schema_name": {
								"value": "@pipeline().parameters.schema_name",
								"type": "Expression"
							},
							"table_name": {
								"value": "@pipeline().parameters.table_name",
								"type": "Expression"
							},
							"server_name": {
								"value": "@pipeline().parameters.server_name",
								"type": "Expression"
							},
							"database_name": {
								"value": "@pipeline().parameters.database_name",
								"type": "Expression"
							},
							"user_name": {
								"value": "@pipeline().parameters.user_name",
								"type": "Expression"
							},
							"secret_name": {
								"value": "@pipeline().parameters.secret_name",
								"type": "Expression"
							},
							"key_vault_uri": {
								"value": "@pipeline().globalParameters.key_vault_uri",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "LookupOldWaterMarkActivity",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'SELECT * FROM watermarktable WHERE TableName = ''', \n    toLower(concat(pipeline().parameters.datastore_name, '.',pipeline().parameters.schema_name, '_', pipeline().parameters.table_name, '_checkpoint_version')), \n    ''' ORDER BY watermarkvalue DESC'\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azure_sql_managed_identity",
						"type": "DatasetReference",
						"parameters": {
							"server_name": {
								"value": "@pipeline().globalParameters.sqldb_fqdn",
								"type": "Expression"
							},
							"database_name": "watermarks",
							"table_name": "watermarktable"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "If version change",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "LookupOldWaterMarkActivity",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@if(\n    greater(length(activity('LookupOldWaterMarkActivity').output.value), 0),\n    not(equals(\n        coalesce(activity('LookupOldWaterMarkActivity').output.value[0].WatermarkValue, -1),\n        pipeline().parameters.checkpoint_version\n    )),\n    true\n)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Delete cdc table",
							"description": "In the case if a full load we're going to delete all the old table files in the storage account folder. ",
							"type": "Delete",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ds_adls_parquet",
									"type": "DatasetReference",
									"parameters": {
										"storage_account_uri": "@pipeline().globalParameters.storage_account_datalake_uri",
										"container_name": "@pipeline().globalParameters.storage_container_datalake",
										"datastore": {
											"value": "@pipeline().parameters.datastore_name",
											"type": "Expression"
										},
										"dataset": {
											"value": "@concat(pipeline().parameters.schema_name, '_', pipeline().parameters.table_name)",
											"type": "Expression"
										},
										"tablename": " "
									}
								},
								"enableLogging": false,
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								}
							}
						}
					]
				}
			},
			{
				"name": "update_watermark",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "If version change",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 0,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT \n  '@{pipeline().parameters.checkpoint_version}' as WatermarkValue,\n  '@{toLower(concat(pipeline().parameters.datastore_name, '.',pipeline().parameters.schema_name, '_', pipeline().parameters.table_name, '_checkpoint_version'))}' as TableName;",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": {
							"value": "DELETE FROM watermarktable\nWHERE [TableName] = '@{toLower(concat(pipeline().parameters.datastore_name, '.',pipeline().parameters.schema_name, '_', pipeline().parameters.table_name, '_checkpoint_version'))}';",
							"type": "Expression"
						},
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_azure_sql_managed_identity",
						"type": "DatasetReference",
						"parameters": {
							"server_name": "@pipeline().globalParameters.sqldb_fqdn",
							"database_name": "watermarks",
							"table_name": "watermarktable"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_azure_sql_managed_identity",
						"type": "DatasetReference",
						"parameters": {
							"server_name": {
								"value": "@pipeline().globalParameters.sqldb_fqdn",
								"type": "Expression"
							},
							"database_name": "watermarks",
							"table_name": "watermarktable"
						}
					}
				]
			},
			{
				"name": "pl_execute_failures",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute adb ingestion",
						"dependencyConditions": [
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trigger_ingestion_failure",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@concat(pipeline().parameters.schema_name, '_', pipeline().parameters.table_name)",
							"type": "Expression"
						},
						"datastore_name": {
							"value": "@pipeline().parameters.datastore_name",
							"type": "Expression"
						},
						"use_case": {
							"value": "@pipeline().parameters.use_case",
							"type": "Expression"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"trigger_time": {
							"value": "@convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time')",
							"type": "Expression"
						},
						"skip_orchestration": {
							"value": "@pipeline().parameters.skip_orchestration",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "pl_execute_failure",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "update_watermark",
						"dependencyConditions": [
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trigger_ingestion_failure",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@concat(pipeline().parameters.schema_name, '_', pipeline().parameters.table_name)",
							"type": "Expression"
						},
						"datastore_name": {
							"value": "@pipeline().parameters.datastore_name",
							"type": "Expression"
						},
						"use_case": {
							"value": "@pipeline().parameters.use_case",
							"type": "Expression"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"trigger_time": {
							"value": "@convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time')",
							"type": "Expression"
						},
						"skip_orchestration": {
							"value": "@pipeline().parameters.skip_orchestration",
							"type": "Expression"
						}
					}
				}
			}
		],
		"concurrency": 50,
		"parameters": {
			"schema_name": {
				"type": "String",
				"defaultValue": "dbo"
			},
			"table_name": {
				"type": "String",
				"defaultValue": "cnf_workstation"
			},
			"server_name": {
				"type": "String",
				"defaultValue": "cdc-mx-data.privatelink.database.windows.net,1433"
			},
			"database_name": {
				"type": "String",
				"defaultValue": "BOS_FPK"
			},
			"user_name": {
				"type": "String",
				"defaultValue": "SVCBISharePoint"
			},
			"secret_name": {
				"type": "String",
				"defaultValue": "onprem-sqlserver-sql-svc-prd-password"
			},
			"use_case": {
				"type": "string",
				"defaultValue": "cdc_test"
			},
			"datastore_name": {
				"type": "string",
				"defaultValue": "omni"
			},
			"pk": {
				"type": "string",
				"defaultValue": "WorkstationId,WorkstationAK"
			},
			"checkpoint_version": {
				"type": "string"
			},
			"skip_orchestration": {
				"type": "bool",
				"defaultValue": false
			}
		},
		"annotations": [
			"@concat('datasource_', toLower(pipeline().parameters.datastore_name))",
			"@toLower(pipeline().parameters.table_name)",
			"@toLower(pipeline().parameters.use_case)"
		]
	}
}