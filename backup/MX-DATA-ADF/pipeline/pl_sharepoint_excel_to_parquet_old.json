{
	"name": "pl_sharepoint_excel_to_parquet_old",
	"properties": {
		"activities": [
			{
				"name": "Generate Token",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Get client secret",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": {
							"value": "application/x-www-form-urlencoded",
							"type": "Expression"
						}
					},
					"url": {
						"value": "https://accounts.accesscontrol.windows.net/0b0b76ba-8e32-4c41-8130-65ed5ca4353c/tokens/OAuth/2",
						"type": "Expression"
					},
					"body": {
						"value": "@concat('grant_type=client_credentials&client_id=',pipeline().parameters.user_name,'@0b0b76ba-8e32-4c41-8130-65ed5ca4353c','&client_secret=',replace(replace(activity('Get client secret').output.value, '+', '%2B'), '/', '%2F'),'&resource=00000003-0000-0ff1-ce00-000000000000/miralgroup.sharepoint.com@',pipeline().parameters.tenant_id)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Generate URL",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "base_url",
					"value": {
						"value": "@concat('https://miralgroup.sharepoint.com/sites/', pipeline().parameters.site, '/_api/web/GetFileByServerRelativeUrl(''', \nconcat('/sites/', pipeline().parameters.path, pipeline().parameters.input_file_name),''')/$value')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get client secret",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat(pipeline().globalParameters.key_vault_uri, '/secrets/', pipeline().parameters.secret_name, '?api-version=7.0')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "self-hosted-runtime",
						"type": "IntegrationRuntimeReference"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "Execute adb ingestion",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "if_sheet_name_is_empty",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trigger_adb_ingestion",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@toLower(concat(pipeline().parameters.schema_name,'_',pipeline().parameters.table_name))",
							"type": "Expression"
						},
						"datastore_name": {
							"value": "@toLower(pipeline().parameters.datastore_name)",
							"type": "Expression"
						},
						"skip_orchestration": {
							"value": "@pipeline().parameters.skip_orchestration",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "pl_execute_failure",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute adb ingestion",
						"dependencyConditions": [
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trigger_ingestion_failure",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@toLower(concat(pipeline().parameters.schema_name,'_',pipeline().parameters.table_name))",
							"type": "Expression"
						},
						"datastore_name": {
							"value": "@toLower(pipeline().parameters.datastore_name)",
							"type": "Expression"
						},
						"use_case": {
							"value": "@pipeline().parameters.use_case",
							"type": "Expression"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"trigger_time": {
							"value": "@convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time')",
							"type": "Expression"
						},
						"skip_orchestration": {
							"value": "@pipeline().parameters.skip_orchestration",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "if_sheet_name_is_empty",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Generate Token",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Generate URL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@empty(pipeline().parameters.sheet_name)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "copy_sharepoint_excel_sheet_to_parquet",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.03:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": true
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "ExcelSource",
									"additionalColumns": [
										{
											"name": "source_file_name",
											"value": {
												"value": "@pipeline().parameters.input_file_name",
												"type": "Expression"
											}
										},
										{
											"name": "adf_load_time",
											"value": {
												"value": "@convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time')",
												"type": "Expression"
											}
										}
									],
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET",
										"additionalHeaders": {
											"value": "@{concat('Authorization: Bearer ', activity('Generate Token').output.access_token)}",
											"type": "Expression"
										},
										"requestTimeout": ""
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"value": "@json(replace(string(pipeline().parameters.column_mapping), '\\n', '\\r\\n'))",
									"type": "Expression"
								}
							},
							"inputs": [
								{
									"referenceName": "ds_http_excel_with_sheet",
									"type": "DatasetReference",
									"parameters": {
										"base_url": {
											"value": "@variables('base_url')",
											"type": "Expression"
										},
										"first_row_header": {
											"value": "@pipeline().parameters.first_row_header",
											"type": "Expression"
										},
										"sheet_name": {
											"value": "@pipeline().parameters.sheet_name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_parquet",
									"type": "DatasetReference",
									"parameters": {
										"storage_account_uri": {
											"value": "@pipeline().globalParameters.storage_account_datalake_uri",
											"type": "Expression"
										},
										"container_name": {
											"value": "@pipeline().globalParameters.storage_container_datalake",
											"type": "Expression"
										},
										"datastore": {
											"value": "@toLower(pipeline().parameters.datastore_name)\n",
											"type": "Expression"
										},
										"dataset": {
											"value": "@toLower(concat(pipeline().parameters.schema_name,'_',pipeline().parameters.table_name))",
											"type": "Expression"
										},
										"tablename": {
											"value": "@pipeline().parameters.input_file_name",
											"type": "Expression"
										}
									}
								}
							]
						}
					],
					"ifTrueActivities": [
						{
							"name": "copy_sharepoint_excel_to_parquet",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.03:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": true
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "ExcelSource",
									"additionalColumns": [
										{
											"name": "adf_load_time",
											"value": {
												"value": "@convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time')",
												"type": "Expression"
											}
										}
									],
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET",
										"additionalHeaders": {
											"value": "@{concat('Authorization: Bearer ', activity('Generate Token').output.access_token)}",
											"type": "Expression"
										},
										"requestTimeout": ""
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"value": "@json(replace(string(pipeline().parameters.column_mapping), '\\n', '\\r\\n'))",
									"type": "Expression"
								}
							},
							"inputs": [
								{
									"referenceName": "ds_http_excel",
									"type": "DatasetReference",
									"parameters": {
										"base_url": {
											"value": "@variables('base_url')",
											"type": "Expression"
										},
										"first_row_header": {
											"value": "@pipeline().parameters.first_row_header",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_parquet",
									"type": "DatasetReference",
									"parameters": {
										"storage_account_uri": {
											"value": "@pipeline().globalParameters.storage_account_datalake_uri",
											"type": "Expression"
										},
										"container_name": {
											"value": "@pipeline().globalParameters.storage_container_datalake",
											"type": "Expression"
										},
										"datastore": {
											"value": "@toLower(pipeline().parameters.datastore_name)",
											"type": "Expression"
										},
										"dataset": {
											"value": "@toLower(concat(pipeline().parameters.schema_name,'_',pipeline().parameters.table_name))",
											"type": "Expression"
										},
										"tablename": {
											"value": "@pipeline().parameters.input_file_name",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"concurrency": 20,
		"parameters": {
			"path": {
				"type": "string",
				"defaultValue": "VOGTeam/Shared Documents/Reports and WFM/YC Incentives Automation/Mapping Files/"
			},
			"secret_name": {
				"type": "String",
				"defaultValue": "cloud-sharepoint-svc-prd-password"
			},
			"user_name": {
				"type": "String",
				"defaultValue": "23548861-9379-4ee8-9b2f-680f630b2020"
			},
			"datastore_name": {
				"type": "String",
				"defaultValue": "sharepoint_file"
			},
			"table_name": {
				"type": "String",
				"defaultValue": "queue_grouping_matrix"
			},
			"schema_name": {
				"type": "string",
				"defaultValue": "ycautomation"
			},
			"input_file_name": {
				"type": "string",
				"defaultValue": "Queue_Grouping_Matrix_20240731.xlsx"
			},
			"sheet_name": {
				"type": "string"
			},
			"tenant_id": {
				"type": "String",
				"defaultValue": "0b0b76ba-8e32-4c41-8130-65ed5ca4353c"
			},
			"column_mapping": {
				"type": "Object"
			},
			"site": {
				"type": "string",
				"defaultValue": "VOGTeam"
			},
			"use_case": {
				"type": "string",
				"defaultValue": "ycautomation"
			},
			"first_row_header": {
				"type": "bool",
				"defaultValue": true
			},
			"skip_orchestration": {
				"type": "bool",
				"defaultValue": false
			}
		},
		"variables": {
			"base_url": {
				"type": "String"
			}
		},
		"annotations": [
			"@concat('datasource_', toLower(pipeline().parameters.datastore_name))",
			"@toLower(pipeline().parameters.table_name)",
			"@toLower(pipeline().parameters.use_case)"
		]
	}
}