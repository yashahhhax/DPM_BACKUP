{
	"name": "pl_sharepoint_to_volume_old",
	"properties": {
		"activities": [
			{
				"name": "Generate Token",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Get client secret",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": {
							"value": "application/x-www-form-urlencoded",
							"type": "Expression"
						}
					},
					"url": {
						"value": "https://accounts.accesscontrol.windows.net/0b0b76ba-8e32-4c41-8130-65ed5ca4353c/tokens/OAuth/2",
						"type": "Expression"
					},
					"body": {
						"value": "@concat('grant_type=client_credentials&client_id=',pipeline().parameters.user_name,'@0b0b76ba-8e32-4c41-8130-65ed5ca4353c','&client_secret=',replace(replace(activity('Get client secret').output.value, '+', '%2B'), '/', '%2F'),'&resource=00000003-0000-0ff1-ce00-000000000000/farahleisure.sharepoint.com@',pipeline().parameters.tenant_id)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Generate URL",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "base_url",
					"value": {
						"value": "@concat('https://farahleisure.sharepoint.com/sites/', pipeline().parameters.site, '/_api/web/GetFileByServerRelativeUrl(''', \nconcat('/sites/', pipeline().parameters.path, pipeline().parameters.table_name),''')/$value')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Copy SharePoint to parquet",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Generate Token",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Generate URL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.03:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET",
							"additionalHeaders": {
								"value": "@{concat('Authorization: Bearer ', activity('Generate Token').output.access_token)}",
								"type": "Expression"
							},
							"requestTimeout": ""
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_http_binary",
						"type": "DatasetReference",
						"parameters": {
							"base_url": {
								"value": "@variables('base_url')",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_binary",
						"type": "DatasetReference",
						"parameters": {
							"container_name": "ingestion-volume-files",
							"directory": {
								"value": "@replace(replace(join(skip(split(string(pipeline().parameters.path), '/'), 1), '_'), ' ', '_'), ',', '_')",
								"type": "Expression"
							},
							"file_name": {
								"value": "@pipeline().parameters.table_name",
								"type": "Expression"
							},
							"storage_account_uri": {
								"value": "@pipeline().globalParameters.storage_account_datalake_uri",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Get client secret",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat(pipeline().globalParameters.key_vault_uri, '/secrets/', pipeline().parameters.secret_name, '?api-version=7.0')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "self-hosted-runtime",
						"type": "IntegrationRuntimeReference"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "pl_execute_failure",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Copy SharePoint to parquet",
						"dependencyConditions": [
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trigger_ingestion_failure",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@pipeline().parameters.table_name",
							"type": "Expression"
						},
						"datastore_name": {
							"value": "@pipeline().parameters.datastore_name",
							"type": "Expression"
						},
						"use_case": {
							"value": "@pipeline().parameters.use_case",
							"type": "Expression"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"trigger_time": {
							"value": "@convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time')",
							"type": "Expression"
						},
						"skip_orchestration": {
							"value": "@pipeline().parameters.skip_orchestration",
							"type": "Expression"
						}
					}
				}
			}
		],
		"concurrency": 20,
		"parameters": {
			"path": {
				"type": "string",
				"defaultValue": "FARAHSWAD/EO/Ride Downtime Report/2025/"
			},
			"secret_name": {
				"type": "String",
				"defaultValue": "cloud-sharepoint-svc-prd-password"
			},
			"user_name": {
				"type": "String",
				"defaultValue": "23548861-9379-4ee8-9b2f-680f630b2020"
			},
			"datastore_name": {
				"type": "String",
				"defaultValue": "sharepoint_file"
			},
			"table_name": {
				"type": "String",
				"defaultValue": "01. SWAD Ride Performance Report - January 2025.xlsx"
			},
			"tenant_id": {
				"type": "String",
				"defaultValue": "0b0b76ba-8e32-4c41-8130-65ed5ca4353c"
			},
			"column_mapping": {
				"type": "Object"
			},
			"site": {
				"type": "string",
				"defaultValue": "FARAHSWAD/EO"
			},
			"use_case": {
				"type": "string"
			},
			"skip_orchestration": {
				"type": "bool",
				"defaultValue": false
			}
		},
		"variables": {
			"base_url": {
				"type": "String"
			}
		},
		"annotations": [
			"@concat('datasource_', toLower(pipeline().parameters.datastore_name))",
			"@toLower(pipeline().parameters.table_name)",
			"@toLower(pipeline().parameters.use_case)"
		]
	}
}