{
	"name": "pl_odbc_to_parquet_fullload",
	"properties": {
		"activities": [
			{
				"name": "odbc_to_parquet",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.03:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "OdbcSource",
						"additionalColumns": [
							{
								"name": "adf_load_time",
								"value": {
									"value": "@convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time')",
									"type": "Expression"
								}
							}
						],
						"query": {
							"value": "@if(\n    equals(empty(pipeline().parameters.query), false), \n    replace(pipeline().parameters.query, '\\n', '\\r\\n'), \n    concat('SELECT * FROM ', pipeline().parameters.schema_name, '.', pipeline().parameters.table_name)\n)\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"value": "@json(replace(string(pipeline().parameters.column_mapping), '\\n', '\\r\\n'))",
						"type": "Expression"
					}
				},
				"inputs": [
					{
						"referenceName": "ds_odbc",
						"type": "DatasetReference",
						"parameters": {
							"table_name": {
								"value": "@concat(pipeline().parameters.schema_name, '.', pipeline().parameters.table_name)",
								"type": "Expression"
							},
							"connection_string": {
								"value": "@pipeline().parameters.connection_string",
								"type": "Expression"
							},
							"user_name": {
								"value": "@pipeline().parameters.user_name",
								"type": "Expression"
							},
							"key_vault_uri": {
								"value": "@pipeline().globalParameters.key_vault_uri",
								"type": "Expression"
							},
							"secret_name": {
								"value": "@pipeline().parameters.secret_name",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_parquet",
						"type": "DatasetReference",
						"parameters": {
							"storage_account_uri": {
								"value": "@pipeline().globalParameters.storage_account_datalake_uri",
								"type": "Expression"
							},
							"container_name": {
								"value": "@pipeline().globalParameters.storage_container_datalake",
								"type": "Expression"
							},
							"datastore": {
								"value": "@toLower(pipeline().parameters.datastore_name)\n",
								"type": "Expression"
							},
							"dataset": {
								"value": "@concat(pipeline().parameters.datastore_name, '_', pipeline().parameters.schema_name, '_', pipeline().parameters.table_name)",
								"type": "Expression"
							},
							"tablename": {
								"value": "@pipeline().parameters.table_name",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Execute adb ingestion",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Delete incremental files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trigger_adb_ingestion",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@concat(pipeline().parameters.datastore_name, '_', pipeline().parameters.schema_name, '_', pipeline().parameters.table_name)",
							"type": "Expression"
						},
						"datastore_name": {
							"value": "@toLower(pipeline().parameters.datastore_name)\n",
							"type": "Expression"
						},
						"total_rows": {
							"value": "@activity('odbc_to_parquet').output.rowsRead",
							"type": "Expression"
						},
						"skip_orchestration": {
							"value": "@pipeline().parameters.skip_orchestration",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Delete incremental files",
				"type": "Delete",
				"dependsOn": [
					{
						"activity": "odbc_to_parquet",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_adls_parquet",
						"type": "DatasetReference",
						"parameters": {
							"storage_account_uri": "@pipeline().globalParameters.storage_account_datalake_uri",
							"container_name": "@pipeline().globalParameters.storage_container_datalake",
							"datastore": "@toLower(pipeline().parameters.datastore_name)",
							"dataset": {
								"value": "@concat(pipeline().parameters.datastore_name, '_', pipeline().parameters.schema_name, '_', pipeline().parameters.table_name)",
								"type": "Expression"
							},
							"tablename": {
								"value": " ",
								"type": "Expression"
							}
						}
					},
					"enableLogging": false,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": false,
						"wildcardFileName": "20*",
						"enablePartitionDiscovery": false
					}
				}
			},
			{
				"name": "pl_execute_failure",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute adb ingestion",
						"dependencyConditions": [
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trigger_ingestion_failure",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@concat(pipeline().parameters.datastore_name, '_', pipeline().parameters.schema_name, '_', pipeline().parameters.table_name)",
							"type": "Expression"
						},
						"datastore_name": {
							"value": "@pipeline().parameters.datastore_name",
							"type": "Expression"
						},
						"use_case": {
							"value": "@pipeline().parameters.use_case",
							"type": "Expression"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"trigger_time": {
							"value": "@convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time')",
							"type": "Expression"
						},
						"skip_orchestration": {
							"value": "@pipeline().parameters.skip_orchestration",
							"type": "Expression"
						}
					}
				}
			}
		],
		"concurrency": 20,
		"parameters": {
			"table_name": {
				"type": "String",
				"defaultValue": "XXFLP_BI_GL_ACCT_ANALY_OB_ALL"
			},
			"datastore_name": {
				"type": "String",
				"defaultValue": "fusion"
			},
			"column_mapping": {
				"type": "Object"
			},
			"query": {
				"type": "string"
			},
			"use_case": {
				"type": "string"
			},
			"schema_name": {
				"type": "String",
				"defaultValue": "XXAPPS"
			},
			"connection_string": {
				"type": "String",
				"defaultValue": "DSN=ATP_UAT"
			},
			"user_name": {
				"type": "String",
				"defaultValue": "XXBIP"
			},
			"secret_name": {
				"type": "string",
				"defaultValue": "onprem-atp-oracle-svc-uat-password"
			},
			"skip_orchestration": {
				"type": "bool",
				"defaultValue": false
			}
		},
		"annotations": [
			"@concat('datasource_', toLower(pipeline().parameters.datastore_name))",
			"@toLower(pipeline().parameters.table_name)",
			"@toLower(pipeline().parameters.use_case)"
		]
	}
}