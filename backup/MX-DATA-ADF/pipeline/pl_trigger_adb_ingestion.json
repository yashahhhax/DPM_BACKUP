{
	"name": "pl_trigger_adb_ingestion",
	"properties": {
		"activities": [
			{
				"name": "Check if incremental table",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check if trans_job exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@pipeline().parameters.is_incremental",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "pl_trigger_incremental",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_trigger_workflow",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"job_id": {
										"value": "@pipeline().globalParameters.databricks_ingest_incremental_job_id",
										"type": "Expression"
									},
									"job_parameters": {
										"value": "@json(concat(\n  '{',\n    '\"table_name\":\"', toLower(pipeline().parameters.table_name), '\",',\n    '\"ingestion_schema\":\"', toLower(pipeline().parameters.datastore_name), '\",',\n    '\"pk\":\"', pipeline().parameters.pk, '\",',\n    '\"is_fullload\":\"', pipeline().parameters.is_fullload, '\",',\n    '\"environment\":\"', pipeline().globalParameters.environment, '\",',\n    '\"timestamp_col\":\"', pipeline().parameters.timestamp_col, '\"',\n  '}'\n))",
										"type": "Expression"
									},
									"databricks_workspace_url": {
										"value": "@pipeline().globalParameters.databricks_ingestion_workspace_url",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "get_ingest_incre_return_values",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "pl_trigger_incremental",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 300,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@concat(pipeline().globalParameters.databricks_ingestion_workspace_url,'/api/2.1/jobs/runs/get-output?run_id=',activity('pl_trigger_incremental').output.pipelineReturnValue.task_run_id)",
									"type": "Expression"
								},
								"connectVia": {
									"referenceName": "on-prem-self-hosted-runtime",
									"type": "IntegrationRuntimeReference"
								},
								"authentication": {
									"type": "MSI",
									"resource": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
								}
							}
						},
						{
							"name": "set_ingest_incremental_stats",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "get_ingest_incre_return_values",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "ingest_incremental_stats",
								"value": {
									"value": "@if(\n    and(\n        contains(activity('get_ingest_incre_return_values').output, 'notebook_output'),\n        and(\n            contains(activity('get_ingest_incre_return_values').output.notebook_output, 'result'),\n            startswith(\n                string(activity('get_ingest_incre_return_values').output.notebook_output.result),\n                '{'\n            )\n        )\n    ),\n    string(activity('get_ingest_incre_return_values').output.notebook_output.result),\n    null\n)",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Update table tags",
				"description": "Will update the last_updated tag of a table. Will fail if it's a new table. Therefore retry timer has been set to wait  so the sync job has run. ",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "if_run_backup",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 300,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "@concat(\n        pipeline().globalParameters.databricks_transformation_workspace_url,\n        '/api/2.0/sql/statements/?warehouse_id=',\n        pipeline().globalParameters.databricks_transformation_sql_serverless_id,\n        '&statement=alter%20table%20transformation_',\n        pipeline().globalParameters.environment,\n        '.brz_',\n        toLower(replace(pipeline().parameters.datastore_name, '-', '_')),\n        '.vw_',\n        toLower(replace(pipeline().parameters.table_name, '-', '_')),\n        '%20set%20tags%20(%27last_updated%27%20%3D%20%27',\n        if(empty(pipeline().parameters.last_updated_tag),convertTimeZone(utcnow(), 'UTC', 'Arabian Standard Time'), pipeline().parameters.last_updated_tag),\n        '%27,%20%27total_rows%27%20%3D%20%27', string(pipeline().parameters.total_rows), '%27)'\n    )",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "on-prem-self-hosted-runtime",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"cause": "Kicked off from ADF"
					},
					"authentication": {
						"type": "MSI",
						"resource": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
					}
				}
			},
			{
				"name": "Check if ingest_job exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Switch",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(empty(variables('ingest_job_id')))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "pl_trigger_ingest_table_wf",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_trigger_workflow",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"job_id": {
										"value": "@variables('ingest_job_id')",
										"type": "Expression"
									},
									"job_parameters": {
										"value": "@pipeline().parameters.additional_wf_parameters",
										"type": "Expression"
									},
									"databricks_workspace_url": {
										"value": "@pipeline().globalParameters.databricks_ingestion_workspace_url",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "get_wf_return_values",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "pl_trigger_ingest_table_wf",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 300,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@concat(pipeline().globalParameters.databricks_ingestion_workspace_url,'/api/2.1/jobs/runs/get-output?run_id=',activity('pl_trigger_ingest_table_wf').output.pipelineReturnValue.task_run_id)",
									"type": "Expression"
								},
								"connectVia": {
									"referenceName": "on-prem-self-hosted-runtime",
									"type": "IntegrationRuntimeReference"
								},
								"authentication": {
									"type": "MSI",
									"resource": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
								}
							}
						},
						{
							"name": "set_total_rows",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "get_wf_return_values",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "total_rows",
								"value": {
									"value": "@coalesce(\n    if(\n        startswith(\n            string(activity('get_wf_return_values').output.notebook_output?.result),\n            '{'\n        ),\n        json(activity('get_wf_return_values').output.notebook_output.result).total_rows,\n        null\n    ),\n    0\n)",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "if_run_ingestion_sync_wf",
				"description": "If table does not yet exist and < 2 sync jobs are active it will trigger/queue a new run.",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check if incremental table",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set table_exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(or(\n    pipeline().parameters.is_incremental,\n    or(\n        pipeline().parameters.skip_sync,\n        variables('table_exists')\n    )\n))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Execute Sync job ingestion",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_conditionally_trigger_workflow",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"job_id": {
										"value": "@pipeline().globalParameters.databricks_sync_ingestion_job_id",
										"type": "Expression"
									},
									"job_parameters": "{}",
									"max_concurrent": 2,
									"databricks_workspace_url": {
										"value": "@pipeline().globalParameters.databricks_ingestion_workspace_url",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Check if trans_job exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check if ingest_job exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(empty(variables('trans_job_id')))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "pl_trigger_trans_table_wf",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_trigger_workflow",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"job_id": {
										"value": "@variables('trans_job_id')",
										"type": "Expression"
									},
									"job_parameters": {
										"value": "@pipeline().parameters.additional_wf_parameters",
										"type": "Expression"
									},
									"databricks_workspace_url": {
										"value": "@pipeline().globalParameters.databricks_transformation_workspace_url",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "if_run_trans_sync_wf",
				"description": "If table does not yet exist and < 2 sync jobs are active it will trigger/queue a new run.",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "if_run_ingestion_sync_wf",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(or(pipeline().parameters.skip_sync, variables('table_exists')))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Execute Sync job transformation",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_conditionally_trigger_workflow",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"job_id": {
										"value": "@pipeline().globalParameters.databricks_sync_transformation_job_id",
										"type": "Expression"
									},
									"job_parameters": "{}",
									"max_concurrent": 2,
									"databricks_workspace_url": {
										"value": "@pipeline().globalParameters.databricks_transformation_workspace_url",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "if_run_backup",
				"description": "",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "if_run_trans_sync_wf",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(pipeline().parameters.skip_backup)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "exec_backup",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_trigger_workflow",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"job_id": {
										"value": "@pipeline().globalParameters.databricks_table_specific_backup_job_id",
										"type": "Expression"
									},
									"job_parameters": {
										"value": "@pipeline().parameters.backup_wf_parameters",
										"type": "Expression"
									},
									"databricks_workspace_url": {
										"value": "@pipeline().globalParameters.databricks_transformation_workspace_url",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Get table exists",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 300,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@toLower(concat(\n  pipeline().globalParameters.databricks_transformation_workspace_url, \n  '/api/2.1/unity-catalog/tables/transformation_',\n  pipeline().globalParameters.environment,\n  '.brz_',\n     toLower(replace(pipeline().parameters.datastore_name, '-', '_')),\n    '.vw_',\n    toLower(replace(pipeline().parameters.table_name, '-', '_')),\n  '/exists'\n))\n",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "on-prem-self-hosted-runtime",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"cause": "Kicked off from ADF"
					},
					"authentication": {
						"type": "MSI",
						"resource": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
					}
				}
			},
			{
				"name": "Set table_exists",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get table exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "table_exists",
					"value": {
						"value": "@activity('Get table exists').output.table_exists",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Switch",
				"type": "Switch",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@if(\n    not(empty(pipeline().parameters.ingest_job_id)),\n    'by_id',\n    if(\n        not(empty(pipeline().parameters.additional_wf_name)),\n        'by_name',\n        'none'\n    )\n)",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "by_id",
							"activities": [
								{
									"name": "set_ingest_job_id",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "ingest_job_id",
										"value": {
											"value": "@pipeline().parameters.ingest_job_id",
											"type": "Expression"
										}
									}
								},
								{
									"name": "set_trans_job_id",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "trans_job_id",
										"value": {
											"value": "@pipeline().parameters.trans_job_id",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"value": "by_name",
							"activities": [
								{
									"name": "Get ingest_job_list",
									"type": "WebActivity",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 3,
										"retryIntervalInSeconds": 300,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"method": "GET",
										"turnOffAsync": false,
										"url": {
											"value": "@concat(pipeline().globalParameters.databricks_ingestion_workspace_url, '/api/2.1/jobs/list?name=', pipeline().parameters.additional_wf_name)",
											"type": "Expression"
										},
										"connectVia": {
											"referenceName": "on-prem-self-hosted-runtime",
											"type": "IntegrationRuntimeReference"
										},
										"body": {
											"cause": "Kicked off from ADF"
										},
										"authentication": {
											"type": "MSI",
											"resource": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
										}
									}
								},
								{
									"name": "Set ingest_job_id",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Get ingest_job_list",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "ingest_job_id",
										"value": {
											"value": "@if(\n    and(\n        contains(activity('Get ingest_job_list').output, 'jobs'),\n        greater(length(activity('Get ingest_job_list').output.jobs), 0)\n    ),\n    string(activity('Get ingest_job_list').output.jobs[0].job_id),\n    ''\n)",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Get trans_job_list",
									"type": "WebActivity",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 3,
										"retryIntervalInSeconds": 300,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"method": "GET",
										"turnOffAsync": false,
										"url": {
											"value": "@concat(pipeline().globalParameters.databricks_transformation_workspace_url, '/api/2.1/jobs/list?name=', pipeline().parameters.additional_wf_name)",
											"type": "Expression"
										},
										"connectVia": {
											"referenceName": "on-prem-self-hosted-runtime",
											"type": "IntegrationRuntimeReference"
										},
										"body": {
											"cause": "Kicked off from ADF"
										},
										"authentication": {
											"type": "MSI",
											"resource": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
										}
									}
								},
								{
									"name": "Set trans_job_id",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Get trans_job_list",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "trans_job_id",
										"value": {
											"value": "@if(\n    and(\n        contains(activity('Get trans_job_list').output, 'jobs'),\n        greater(length(activity('Get trans_job_list').output.jobs), 0)\n    ),\n    string(activity('Get trans_job_list').output.jobs[0].job_id),\n    ''\n)",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "if_run_wf_orchestration",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Update table tags",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
