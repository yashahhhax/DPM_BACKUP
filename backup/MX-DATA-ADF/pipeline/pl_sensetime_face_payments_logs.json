{
	"name": "pl_sensetime_face_payments_logs",
	"properties": {
		"activities": [
			{
				"name": "GetToken",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"linkedServices": [
						{
							"referenceName": "ls_key_vault",
							"type": "LinkedServiceReference"
						}
					],
					"url": {
						"value": "@concat(pipeline().globalParameters.key_vault_uri, '/secrets/', pipeline().parameters.secret_name, '?api-version=7.0')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "self-hosted-runtime",
						"type": "IntegrationRuntimeReference"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "set_from_date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "from_date",
					"value": {
						"value": "@if(empty(pipeline().parameters.from_date), formatDateTime(addDays(convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time'), -15), 'yyyy-MM-dd'), pipeline().parameters.from_date)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "set_to_date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "to_date",
					"value": {
						"value": "@formatDateTime(addDays(convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time'), -1), 'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "get_number_of_days",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "set_from_date",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "set_to_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "no_of_days",
					"value": {
						"value": "@string(div(sub(ticks(variables('to_date')), ticks(variables('from_date'))),864000000000))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "for_each_day",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "get_number_of_days",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set adf_load_time",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "GetToken",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(0,add(int(variables('no_of_days')),1))",
						"type": "Expression"
					},
					"batchCount": 5,
					"activities": [
						{
							"name": "copy_payments_log_to_json",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:30:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "POST",
									"requestBody": {
										"value": "@concat('{\"query\":{\"bool\":{\"must\":[{\"range\":{\"timeStamp\":{\"gte\":\"', formatDateTime(addDays(variables('from_date'), int(item())), 'yyyy-MM-ddT00:00:00+04:00'), '\",\"lte\":\"', formatDateTime(addDays(variables('from_date'), int(item())), 'yyyy-MM-ddT23:59:59+04:00'), '\"}}}]}},\"from\":0,\"size\":100000}')",
										"type": "Expression"
									},
									"additionalHeaders": {
										"Authorization": {
											"value": "@concat('Basic ', base64(concat(pipeline().parameters.user_name, ':', trim(activity('GetToken').output.value))))",
											"type": "Expression"
										},
										"Content-Type": "application/json"
									},
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_rest_api",
									"type": "DatasetReference",
									"parameters": {
										"base_url": {
											"value": "@pipeline().parameters.base_url",
											"type": "Expression"
										},
										"relative_url": {
											"value": "@concat(pipeline().parameters.relative_url, '_', formatDateTime(addDays(variables('from_date'), int(item())), 'yyyyMM'), '/_search')",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_json",
									"type": "DatasetReference",
									"parameters": {
										"storage_account_uri": {
											"value": "@pipeline().globalParameters.storage_account_datalake_uri",
											"type": "Expression"
										},
										"container_name": {
											"value": "@pipeline().globalParameters.storage_container_datalake",
											"type": "Expression"
										},
										"directory": {
											"value": "@toLower(concat('raw_',pipeline().parameters.datastore_name, '/', pipeline().parameters.schema_name, '_', pipeline().parameters.table_name, '/', variables('adf_load_time')))",
											"type": "Expression"
										},
										"file_name": {
											"value": "@toLower(concat(pipeline().parameters.table_name, '_', formatDateTime(addDays(variables('from_date'), int(item())), 'yyyy-MM-dd'), '.json'))",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Set adf_load_time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "adf_load_time",
					"value": {
						"value": "@formatDateTime(convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time'), 'yyyyMMddHHmmss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Execute_adb_ingestion",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "for_each_day",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trigger_adb_ingestion",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@toLower(concat(pipeline().parameters.schema_name, '_', pipeline().parameters.table_name))",
							"type": "Expression"
						},
						"datastore_name": {
							"value": "@toLower(pipeline().parameters.datastore_name)\n",
							"type": "Expression"
						},
						"additional_wf_name": {
							"value": "@pipeline().parameters.workflow_name",
							"type": "Expression"
						},
						"additional_wf_parameters": {
							"value": "{\n  \"datastore_name\": \"@{pipeline().parameters.datastore_name}\",\n  \"dataset_name\": \"@{pipeline().parameters.schema_name}\",\n  \"table_name\": \"@{pipeline().parameters.table_name}\",\n  \"input_file_name\": \"@{concat(variables('adf_load_time'), '/')}\"\n}",
							"type": "Expression"
						},
						"skip_orchestration": {
							"value": "@pipeline().parameters.skip_orchestration",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "pl_execute_failure",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute_adb_ingestion",
						"dependencyConditions": [
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trigger_ingestion_failure",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@toLower(concat(pipeline().parameters.schema_name, '_', pipeline().parameters.table_name))",
							"type": "Expression"
						},
						"datastore_name": {
							"value": "@toLower(pipeline().parameters.datastore_name)",
							"type": "Expression"
						},
						"use_case": {
							"value": "@pipeline().parameters.use_case",
							"type": "Expression"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"trigger_time": {
							"value": "@convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time')",
							"type": "Expression"
						},
						"skip_orchestration": {
							"value": "@pipeline().parameters.skip_orchestration",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"base_url": {
				"type": "string",
				"defaultValue": "http://10.110.49.133:30875/"
			},
			"relative_url": {
				"type": "string",
				"defaultValue": "business_payment_bill_index_4bbca277-7d7d-49af-96cc-687a4be9c1db"
			},
			"user_name": {
				"type": "string",
				"defaultValue": "sensetime_readonly"
			},
			"secret_name": {
				"type": "string",
				"defaultValue": "cloud-sensetime-api-prd-facepass-payment-logs-apikey"
			},
			"datastore_name": {
				"type": "string",
				"defaultValue": "sensetime_api"
			},
			"schema_name": {
				"type": "string",
				"defaultValue": "sensetime"
			},
			"table_name": {
				"type": "string",
				"defaultValue": "payments_logs_automation"
			},
			"workflow_name": {
				"type": "string",
				"defaultValue": "wf_ingest_sensetime_face_payments_logs"
			},
			"from_date": {
				"type": "string"
			},
			"use_case": {
				"type": "string",
				"defaultValue": "facepassappslogs"
			},
			"skip_orchestration": {
				"type": "bool",
				"defaultValue": false
			}
		},
		"variables": {
			"from_date": {
				"type": "String"
			},
			"to_date": {
				"type": "String"
			},
			"no_of_days": {
				"type": "String"
			},
			"adf_load_time": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Facepass"
		},
		"annotations": [
			"@concat('datasource_', toLower(pipeline().parameters.datastore_name))",
			"@toLower(pipeline().parameters.table_name)",
			"@toLower(pipeline().parameters.use_case)"
		]
	}
}