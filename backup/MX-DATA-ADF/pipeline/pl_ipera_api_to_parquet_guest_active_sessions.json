{
	"name": "pl_ipera_api_to_parquet_guest_active_sessions",
	"properties": {
		"activities": [
			{
				"name": "pl_execute_failure_ingest",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "If greater than 21_00",
						"dependencyConditions": [
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trigger_ingestion_failure",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@concat(pipeline().parameters.dataset_name,'_',pipeline().parameters.table_name)",
							"type": "Expression"
						},
						"datastore_name": {
							"value": "@pipeline().parameters.datastore_name",
							"type": "Expression"
						},
						"use_case": {
							"value": "@pipeline().parameters.use_case",
							"type": "Expression"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"trigger_time": {
							"value": "@convertTimeZone(pipeline().TriggerTime, 'UTC', 'Arabian Standard Time')",
							"type": "Expression"
						},
						"skip_orchestration": {
							"value": "@pipeline().parameters.skip_orchestration",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "If greater than 21_00",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Set first_execution",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greaterOrEquals(\n    ticks(convertTimeZone(pipeline().TriggerTime,'UTC','Arabian Standard Time')),\n    ticks(\n        concat(\n            formatDateTime(convertTimeZone(pipeline().TriggerTime,'UTC','Arabian Standard Time'),'yyyy-MM-dd'),\n            'T20:55:00'\n        )\n    )\n)\n",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "pl_trigger_workflow",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Get_job_id",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_trigger_workflow",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"job_id": {
										"value": "@string(activity('Get_job_id').output.jobs[0].job_id)",
										"type": "Expression"
									},
									"job_parameters": {
										"value": "{\n  \"base_url\" : \"@{pipeline().parameters.base_url}\",\n  \"relative_url\":\"@{pipeline().parameters.relative_url}\",\n  \"secret_key\":\"@{pipeline().parameters.secret_name}\",\n  \"datastore_name\": \"@{toLower(pipeline().parameters.datastore_name)}\",\n  \"dataset_name\": \"@{toLower(pipeline().parameters.dataset_name)}\",\n  \"table_name\": \"@{toLower(pipeline().parameters.table_name)}\",\n  \"first_execution\":\"@{variables('first_execution')}\"\n}",
										"type": "Expression"
									},
									"databricks_workspace_url": {
										"value": "@pipeline().globalParameters.databricks_ingestion_workspace_url",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Get_job_id",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@concat(pipeline().globalParameters.databricks_ingestion_workspace_url, '/api/2.1/jobs/list?name=', pipeline().parameters.workflow_name)",
									"type": "Expression"
								},
								"connectVia": {
									"referenceName": "self-hosted-runtime",
									"type": "IntegrationRuntimeReference"
								},
								"authentication": {
									"type": "MSI",
									"resource": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Execute adb ingestion",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_trigger_adb_ingestion",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_name": {
										"value": "@toLower(concat(pipeline().parameters.dataset_name,'_',pipeline().parameters.table_name))",
										"type": "Expression"
									},
									"datastore_name": {
										"value": "@toLower(pipeline().parameters.datastore_name)\n",
										"type": "Expression"
									},
									"additional_wf_name": {
										"value": "@pipeline().parameters.workflow_name",
										"type": "Expression"
									},
									"additional_wf_parameters": {
										"value": "{\n  \"base_url\" : \"@{pipeline().parameters.base_url}\",\n  \"relative_url\":\"@{pipeline().parameters.relative_url}\",\n  \"secret_key\":\"@{pipeline().parameters.secret_name}\",\n  \"datastore_name\": \"@{toLower(pipeline().parameters.datastore_name)}\",\n  \"dataset_name\": \"@{toLower(pipeline().parameters.dataset_name)}\",\n  \"table_name\": \"@{toLower(pipeline().parameters.table_name)}\",\n  \"first_execution\":\"@{variables('first_execution')}\"\n}",
										"type": "Expression"
									},
									"skip_orchestration": {
										"value": "@pipeline().parameters.skip_orchestration",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Set first_execution",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "first_execution",
					"value": {
						"value": "@if(and(\n    greaterOrEquals(formatDateTime(convertTimeZone(pipeline().TriggerTime,'UTC','Arabian Standard Time'), 'HH:mm:ss'), '08:00:00'),\n    less(formatDateTime(convertTimeZone(pipeline().TriggerTime,'UTC','Arabian Standard Time'), 'HH:mm:ss'), '08:01:00')\n),\n'True','False')",
						"type": "Expression"
					}
				}
			}
		],
		"concurrency": 20,
		"parameters": {
			"secret_name": {
				"type": "string",
				"defaultValue": "cloud-iperawifi-api-prd-activesessions-apikey"
			},
			"base_url": {
				"type": "string",
				"defaultValue": "https://api.iperawifi.com/api/v1/"
			},
			"datastore_name": {
				"type": "string",
				"defaultValue": "ipera"
			},
			"dataset_name": {
				"type": "string",
				"defaultValue": "guest_active_sessions"
			},
			"table_name": {
				"type": "string",
				"defaultValue": "swad"
			},
			"relative_url": {
				"type": "string",
				"defaultValue": "locations-analytics/active-sessions"
			},
			"workflow_name": {
				"type": "string",
				"defaultValue": "wf_ingest_ipera_api_to_parquet_every_minute"
			},
			"use_case": {
				"type": "string",
				"defaultValue": "ipera"
			},
			"skip_orchestration": {
				"type": "bool",
				"defaultValue": false
			}
		},
		"variables": {
			"first_execution": {
				"type": "String",
				"defaultValue": "False"
			}
		},
		"folder": {
			"name": "Ipera"
		},
		"annotations": [
			"@concat('datasource_', toLower(pipeline().parameters.datastore_name))",
			"@toLower(concat(pipeline().parameters.dataset_name,'_',pipeline().parameters.table_name))",
			"@toLower(pipeline().parameters.use_case)"
		]
	}
}