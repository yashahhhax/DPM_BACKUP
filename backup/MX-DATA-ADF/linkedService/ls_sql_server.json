{
	"name": "ls_sql_server",
	"properties": {
		"parameters": {
			"key_vault_uri": {
				"type": "String"
			},
			"server_name": {
				"type": "String"
			},
			"database_name": {
				"type": "String"
			},
			"user_name": {
				"type": "String"
			},
			"secret_name": {
				"type": "String"
			}
		},
		"annotations": [],
		"type": "SqlServer",
		"typeProperties": {
			"server": "@{linkedService().server_name}",
			"database": "@{linkedService().database_name}",
			"encrypt": "mandatory",
			"trustServerCertificate": true,
			"authenticationType": "Windows",
			"userName": "@{linkedService().user_name}",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_key_vault",
					"type": "LinkedServiceReference",
					"parameters": {
						"key_vault_uri": {
							"value": "@linkedService().key_vault_uri",
							"type": "Expression"
						}
					}
				},
				"secretName": {
					"value": "@linkedService().secret_name",
					"type": "Expression"
				}
			}
		},
		"connectVia": {
			"referenceName": "self-hosted-runtime",
			"type": "IntegrationRuntimeReference"
		}
	}
}